<header class="site-header">
  <nav class="site-header__inner" aria-label="Основная навигация">
    <%= link_to root_path, class: "brand" do %>
      <svg class="brand__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="5" width="18" height="16" rx="3" stroke="currentColor" stroke-width="2"/>
        <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <circle cx="12" cy="15" r="2" fill="currentColor"/>
      </svg>
      <span>Календарь звонков</span>
    <% end %>

    <%= link_to "Записаться", book_path, class: "site-header__link" unless current_page?(book_path) %>
  </nav>
</header>
