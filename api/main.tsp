import "@typespec/http";

using Http;

@service(#{ title: "Call Calendar API" })
namespace CallCalendar;

model EventType {
  /** Generated by the server. */
  id: string;
  name: string;
  description: string;
  durationMinutes: int32;
}

model CreateEventTypeRequest {
  name: string;
  description: string;
  durationMinutes: int32;
}

model Slot {
  /** RFC 3339 timestamp in UTC, serialized with the Z suffix. */
  startsAt: utcDateTime;
  /** RFC 3339 timestamp in UTC, serialized with the Z suffix. */
  endsAt: utcDateTime;
}

model CreateBookingRequest {
  eventTypeId: string;
  /** RFC 3339 timestamp in UTC, serialized with the Z suffix. */
  startsAt: utcDateTime;
  guestName: string;
  /** Guest email address. */
  guestEmail: string;
}

model BookingSummary {
  id: string;
  eventTypeId: string;
  eventTypeName: string;
  /** RFC 3339 timestamp in UTC, serialized with the Z suffix. */
  startsAt: utcDateTime;
  /** RFC 3339 timestamp in UTC, serialized with the Z suffix. */
  endsAt: utcDateTime;
  guestName: string;
}

model FieldError {
  field: string;
  message: string;
}

model ApiError {
  code: string;
  message: string;
  fieldErrors?: FieldError[];
}

model ErrorEnvelope {
  error: ApiError;
}

model CreatedEventTypeResponse {
  @statusCode statusCode: 201;
  @body body: EventType;
}

model CreatedBookingResponse {
  @statusCode statusCode: 201;
  @body body: BookingSummary;
}

model NotFoundResponse {
  @statusCode statusCode: 404;
  @body body: ErrorEnvelope;
}

model ConflictResponse {
  @statusCode statusCode: 409;
  @body body: ErrorEnvelope;
}

model ValidationErrorResponse {
  @statusCode statusCode: 422;
  @body body: ErrorEnvelope;
}

@route("/api/event-types")
interface EventTypes {
  /** Return the public catalog of event types. */
  @get
  list(): EventType[];

  /** Create an event type. */
  @post
  create(@body input: CreateEventTypeRequest): CreatedEventTypeResponse | ValidationErrorResponse;

  /** Return available starts for an event type on a local calendar date. */
  @route("/{eventTypeId}/slots")
  @get
  slots(
    @path eventTypeId: string,
    /** YYYY-MM-DD in the Europe/Moscow calendar. */
    @query date: string,
  ): Slot[] | NotFoundResponse | ValidationErrorResponse;
}

@route("/api/bookings")
interface Bookings {
  /** Create a booking; the server calculates its end from the event type duration. */
  @post
  create(
    @body input: CreateBookingRequest,
  ): CreatedBookingResponse | NotFoundResponse | ConflictResponse | ValidationErrorResponse;

  /** Return upcoming bookings without guest email addresses. */
  @route("/upcoming")
  @get
  upcoming(): BookingSummary[];
}

@route("/api/health")
@get
op getHealth(): { status: "ok" };
